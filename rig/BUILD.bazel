# rig-radar — Rd-03E HITL runner: Pi 3B+ SD image + live-deploy via sbc-deploy.
# A package of the rd03e-reverse workspace (sbc_deploy is a bazel_dep in the root
# MODULE.bazel); run from the repo root, no `cd`:
#
#   bazel run //rig:rig-radar.keys        -- init                 # deploy keypair
#   bazel run //rig:rig-radar.image_sd    -- --cross [--device /dev/diskN]  # build/write the SD image
#   bazel run //rig:rig-radar.deploy_live -- rig-radar            # push updates (no reflash)
#   bazel run //rig:rig-radar.ssh         -- rig-radar            # shell into the rig
#   bazel run //rig:rig-radar.seed_tailscale -- rig-radar -- --authkey file:/var/lib/tailscale/authkey
#
# --cross builds the aarch64 image on the Mac (no builder VM; first build compiles
# the Pi kernel from source since the caches only hold native aarch64).
load("@sbc_deploy//deploy:defs.bzl", "sbc_application")

# Exactly the files the nix flake build reads, staged into a hermetic TreeArtifact
# so `nix build` sees deterministic content (not the live workspace / bazel caches).
filegroup(
    name = "flake_srcs",
    srcs = [
        "flake.lock",
        "flake.nix",
        "reserve/catalog.json",
    ] + glob(["nix/**"]),
)

sbc_application(
    name = "rig-radar",
    # flake.nix lives in this package (//rig); path is workspace-relative.
    flake = "rig",
    hostname = "rig-radar",
    board = "@sbc_deploy//deploy/boards:raspberry-pi-3",
    # Headless appliance: drop the rescue toolkit / docs / default extras.
    lean = True,
    flake_srcs = [":flake_srcs"],
)
