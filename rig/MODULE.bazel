"""rig-radar — Rd-03E HITL runner (Raspberry Pi 3B+), an sbc-deploy consumer.

Builds a bootable NixOS SD image that joins the tailnet and runs the hitl-reserve
reservation daemon, exposing a composite 'radar-bench' unit: the ESP32-C6 radar
host + the RP2350 CMSIS-DAP probe on the Rd-03E's GD32E230. See flake.nix / nix/.
"""

module(
    name = "rig_radar",
    version = "0.0.0",
    compatibility_level = 1,
)

# The sbc-deploy framework (the sbc_application macro + boards). Pinned in lockstep
# with the sbc-deploy input in flake.nix (same rev).
bazel_dep(name = "sbc_deploy", version = "0.0.0")
git_override(
    module_name = "sbc_deploy",
    remote = "https://github.com/fughilli/sbc-deploy.git",
    commit = "23c03bdcefa0cd4b90ea1ec611456984d91a389a",
)
