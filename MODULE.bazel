"""rd03e-reverse — Ai-Thinker Rd-03E firmware RE harness (bzlmod).

The generic Ghidra harness + objdump scanners live in rules_reverse_engineering;
this module adds only the Rd-03E / GD32E230 specifics: the ARM Cortex-M
toolchain in //flake.nix, the vendor firmware images fetched by //targets, and a
whole-image analyze target in //ghidra (the generic analyze_lib is archive-only;
these firmware downloads are single images at a fixed base). Drive it with:

    bazel run //ghidra:analyze_fw -- targets/rd03e/2268_XenP102RM01.hex out/fw2268
"""

module(
    name = "rd03e_reverse",
    version = "0.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_reverse_engineering", version = "0.1.0")
git_override(
    module_name = "rules_reverse_engineering",
    remote = "https://github.com/fughilli/rules_reverse_engineering.git",
    commit = "cf8b10d68fcfdd5ff2c087774b8c5bb71d112316",
)

bazel_dep(name = "rules_shell", version = "0.6.1")

# The HITL rig (//rig): a Pi 3B+ SD image + live-deploy via sbc-deploy. Folded
# into this single workspace (was a nested MODULE.bazel) so the whole project is
# one Bazel repo. Pinned in lockstep with the sbc-deploy input in //rig/flake.nix
# (same rev). sbc-deploy targets Bazel 7.7.1 upstream but resolves on this repo's
# 8.3.1; its nix_repo extension uses isolate=True, hence the isolated-usages flag
# in //.bazelrc.
bazel_dep(name = "sbc_deploy", version = "0.0.0")
git_override(
    module_name = "sbc_deploy",
    remote = "https://github.com/fughilli/sbc-deploy.git",
    commit = "23c03bdcefa0cd4b90ea1ec611456984d91a389a",
)
